# ── Server ────────────────────────────────
HOST=0.0.0.0
PORT=8080
DEBUG=false

# ── Database ──────────────────────────────
DB_FILE=chat.db
MSG_HISTORY_LIMIT=300
MSG_TTL_DAYS=30

# ── Security ──────────────────────────────
MAX_MSG_LENGTH=4096
MAX_CONNECTIONS_PER_IP=5
MAX_TOTAL_CONNECTIONS=200
RATE_LIMIT_MSGS=30
RATE_LIMIT_WINDOW=60
WS_HANDSHAKE_TIMEOUT=15

# ── Logging ───────────────────────────────
LOG_FILE=logs/server.log
